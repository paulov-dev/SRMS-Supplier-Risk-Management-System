generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum SupplierStatus {
  ACTIVE
  UNDER_MONITORING
  AT_RISK
  BLOCKED
  INACTIVE
}

enum RiskCodePrefix {
  RM
  IRM
}

enum RiskOpeningReason {
  TIER_2_CHANGE
  PLANT_CHANGE
  SUPPLIER_TRANSFER_PHASE_OUT
  MANUFACTURING_PROCESS_CHANGE
}

enum RiskWorkflowStatus {
  OPEN
  CLOSED
  CANCELED
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

enum PartRiskStatus {
  RED
  YELLOW
  GREEN
  ORANGE
  GREY
  BLUE
}

enum LogisticsStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskPartLogisticsStatus {
  NOT_REQUESTED
  PENDING
  IN_LOGISTICS
  REJECTED
}

enum Trend {
  UP
  DOWN
  STABLE
}

model RiskSequence {
  key           String   @id
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
}

//////////////////////
// USERS & RBAC
//////////////////////

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  photoUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles        UserRole[]
  comments     Comment[]

  createdRisks  RiskEvent[] @relation("CreatedBy")
  assignedRisks RiskEvent[] @relation("AssignedTo")
  closedRisks   RiskEvent[] @relation("ClosedBy")

  requestedLogistics LogisticsRequest[] @relation("LogisticsRequester")
  reviewedLogistics  LogisticsRequest[] @relation("LogisticsReviewer")

  riskPartsAssigned RiskEventPart[] @relation("RiskPartAssignedTo")

  createdActionPlans  RiskActionPlan[] @relation("ActionPlanCreatedBy")
  assignedActionPlans RiskActionPlan[] @relation("ActionPlanAssignedTo")

  buffersCreated LogisticsBuffer[] @relation("BufferCreator")

  auditLogs AuditLog[]
  statusChanges RiskStatusHistory[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique

  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

//////////////////////
// LOCATION
//////////////////////

model Country {
  id      String @id @default(uuid())
  name    String
  isoCode String @unique

  suppliers Supplier[]
}

//////////////////////
// SUPPLIERS
//////////////////////

model Supplier {
  id                  String   @id @default(uuid())
  name                String
  supplierCodeSap     String? @unique
  status              SupplierStatus @default(ACTIVE)
  address             String?
  countryId           String
  riskScore           Int?
  lastRiskCalculation DateTime?
  createdAt           DateTime @default(now())

  country     Country             @relation(fields: [countryId], references: [id])
  contacts    SupplierContact[]
  riskEvents  RiskEvent[]
  riskScores  SupplierRiskScore[]
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  name       String
  email      String?
  phone      String?
  position   String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

//////////////////////
// RISK CORE
//////////////////////

model RiskEvent {
  id             String   @id @default(uuid())

  code           String   @unique
  sequenceNumber Int      @unique
  codePrefix     RiskCodePrefix

  title          String?
  description    String?

  openingReason  RiskOpeningReason

  supplierId     String

  workflowStatus RiskWorkflowStatus @default(OPEN)
  riskLevel      RiskLevel          @default(GREEN)

  createdWeek    Int
  createdYear    Int

  createdById    String
  assignedToId   String?
  closedById     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  closedAt       DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdBy  User  @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])
  closedBy   User? @relation("ClosedBy", fields: [closedById], references: [id])

  parts         RiskEventPart[]
  actionPlans   RiskActionPlan[]
  comments      Comment[]
  logistics     LogisticsRequest[]
  statusHistory RiskStatusHistory[]

  @@index([code])
  @@index([sequenceNumber])
  @@index([supplierId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([workflowStatus])
  @@index([riskLevel])
  @@index([createdWeek, createdYear])
}

model RiskActionPlan {
  id          String   @id @default(uuid())
  riskEventId String

  description String
  dueDate     DateTime

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdById  String
  assignedToId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id])

  createdBy  User @relation("ActionPlanCreatedBy", fields: [createdById], references: [id])
  assignedTo User @relation("ActionPlanAssignedTo", fields: [assignedToId], references: [id])

  @@index([riskEventId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([isCompleted])
}

//////////////////////
// PARTS
//////////////////////

model PartNumber {
  id             String   @id @default(uuid())
  partNumber     String   @unique
  description    String?
  vehicleProgram String?
  createdAt      DateTime @default(now())

  riskParts RiskEventPart[]
  buffers   LogisticsBuffer[]

  @@index([partNumber])
}

model RiskEventPart {
  id           String   @id @default(uuid())
  riskEventId  String
  partNumberId String

  status PartRiskStatus @default(GREEN)

  logisticsStatus RiskPartLogisticsStatus @default(NOT_REQUESTED)

  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEvent  RiskEvent  @relation(fields: [riskEventId], references: [id])
  partNumber PartNumber @relation(fields: [partNumberId], references: [id])

  assignedTo User? @relation("RiskPartAssignedTo", fields: [assignedToId], references: [id])

  @@unique([riskEventId, partNumberId])
  @@index([riskEventId])
  @@index([partNumberId])
  @@index([status])
  @@index([logisticsStatus])
}

//////////////////////
// LOGISTICS
//////////////////////

model LogisticsRequest {
  id          String          @id @default(uuid())
  riskEventId String

  requestedBy String
  assignedTo  String?

  status      LogisticsStatus @default(PENDING)

  requestedAt DateTime @default(now())
  reviewedAt  DateTime?

  notes       String?
  rejectionReason String?

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id])

  requester User  @relation("LogisticsRequester", fields: [requestedBy], references: [id])
  reviewer  User? @relation("LogisticsReviewer", fields: [assignedTo], references: [id])

  buffers LogisticsBuffer[]

  @@index([riskEventId])
  @@index([requestedBy])
  @@index([assignedTo])
  @@index([status])
  @@index([requestedAt])
}

model LogisticsBuffer {
  id                   String   @id @default(uuid())
  logisticsRequestId   String
  partNumberId         String
  bufferQuantity       Int
  coverageDays         Int
  validUntil           DateTime?
  notes                String?
  createdBy            String
  createdAt            DateTime @default(now())

  logisticsRequest LogisticsRequest @relation(fields: [logisticsRequestId], references: [id])
  partNumber       PartNumber       @relation(fields: [partNumberId], references: [id])

  creator User @relation("BufferCreator", fields: [createdBy], references: [id])

  @@index([logisticsRequestId])
  @@index([partNumberId])
  @@index([createdBy])
}

//////////////////////
// COMMENTS & AUDIT
//////////////////////

model Comment {
  id          String   @id @default(uuid())
  riskEventId String
  userId      String
  message     String
  createdAt   DateTime @default(now())

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  changedBy  String
  createdAt  DateTime @default(now())
  ipAddress  String?

  user User @relation(fields: [changedBy], references: [id])

  @@index([changedBy])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}

//////////////////////
// ANALYTICS
//////////////////////

model RiskSnapshot {
  id               String   @id @default(uuid())
  snapshotDate     DateTime
  weekNumber       Int
  year             Int
  totalRisks       Int
  redRisks         Int
  yellowRisks      Int
  greenRisks       Int
  totalPartNumbers Int
  createdAt        DateTime @default(now())
}

model SupplierRiskScore {
  id           String   @id @default(uuid())
  supplierId   String
  score        Int
  probability  Float
  trend        Trend
  riskLevel    String
  calculatedAt DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

//////////////////////
// HISTORY
//////////////////////

model RiskStatusHistory {
  id          String             @id @default(uuid())
  riskEventId String
  oldStatus   RiskWorkflowStatus
  newStatus   RiskWorkflowStatus
  changedBy   String
  changedAt   DateTime           @default(now())

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id])
  user      User      @relation(fields: [changedBy], references: [id])

  @@index([riskEventId])
  @@index([changedBy])
  @@index([changedAt])
}