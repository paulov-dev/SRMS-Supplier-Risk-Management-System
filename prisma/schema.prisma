generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum SupplierStatus {
  ACTIVE
  UNDER_MONITORING
  AT_RISK
  BLOCKED
  INACTIVE
}

enum RiskCodePrefix {
  RM
  IRM
}

enum RiskOpeningReason {
  TIER_2_CHANGE
  PLANT_CHANGE
  SUPPLIER_TRANSFER_PHASE_OUT
  MANUFACTURING_PROCESS_CHANGE
}

enum RiskWorkflowStatus {
  OPEN
  CLOSED
  CANCELED
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
  GREY
  ORANGE
  BLUE
}

enum PartRiskStatus {
  RED
  YELLOW
  GREEN
  ORANGE
  GREY
  BLUE
}

enum LogisticsRequestType {
  BOOK_INCLUSION
  BUFFER_CALCULATION
}

enum LogisticsRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELED
}

enum LogisticsPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskPartLogisticsStatus {
  NOT_REQUESTED
  REQUESTED
  IN_LOGISTICS
  APPROVED
  REJECTED
}

enum Trend {
  UP
  DOWN
  STABLE
}

enum RiskPartHistoryType {
  STATUS_CHANGE
  RESPONSIBLE_CHANGE
  DATA_CHANGE
  LOGISTICS_CHANGE
  MULTIPLE_CHANGE
  NOTE
}

enum RiskActionPlanHistoryType {
  ACTION_PLAN_CREATE
  ACTION_PLAN_UPDATE
  ACTION_PLAN_START
  ACTION_PLAN_SUBMIT_VALIDATION
  ACTION_PLAN_VALIDATE
  ACTION_PLAN_COMPLETE
  ACTION_PLAN_REOPEN
  ACTION_PLAN_CANCEL
  ACTION_PLAN_DELETE
  RESPONSIBLE_CHANGE
  DUE_DATE_CHANGE
  STATUS_CHANGE
  NOTE
}

enum RiskActionPlanStatus {
  OPEN
  IN_PROGRESS
  WAITING_VALIDATION
  COMPLETED
  CANCELED
}

enum RiskActionPlanPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SnapshotWeekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum WeeklySnapshotEventType {
  RISK_CREATED
  RISK_CLOSED
  RISK_CANCELED
  RISK_REOPENED
  RISK_ASSIGNED

  RISK_LEVEL_CHANGED
  RISK_LEVEL_IMPROVED
  RISK_LEVEL_WORSENED

  PART_CREATED
  PART_STATUS_CHANGED

  ACTION_PLAN_CREATED
  ACTION_PLAN_COMPLETED
  ACTION_PLAN_OVERDUE

  LOGISTICS_REQUEST_CREATED
  LOGISTICS_REQUEST_ACCEPTED
  LOGISTICS_REQUEST_APPROVED
  LOGISTICS_REQUEST_REJECTED
  LOGISTICS_REQUEST_CANCELED
}

//////////////////////
// SEQUENCES
//////////////////////

model WeeklyRiskStateSnapshot {
  id String @id @default(uuid())

  week  Int
  month Int
  year  Int

  weekStartDate DateTime
  weekEndDate   DateTime
  snapshotDate  DateTime @default(now())

  riskEventId String

  code  String?
  title String

  riskLevel      RiskLevel
  workflowStatus RiskWorkflowStatus

  assignedToId String?
  supplierId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id], onDelete: Cascade)

  @@unique([riskEventId, week, year])
  @@index([week, year])
  @@index([riskEventId])
  @@index([riskLevel])
  @@index([workflowStatus])
  @@index([assignedToId])
  @@index([supplierId])
}

model WeeklySnapshotConfig {
  id String @id @default(uuid())

  name String @default("Configuração padrão")

  isEnabled Boolean @default(true)

  weekday SnapshotWeekday @default(FRIDAY)

  hour   Int @default(17)
  minute Int @default(0)

  timezone String @default("America/Sao_Paulo")

  allowManualRun       Boolean @default(true)
  overwriteCurrentWeek Boolean @default(true)

  lastRunAt   DateTime?
  lastRunWeek Int?
  lastRunYear Int?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("WeeklySnapshotConfigCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("WeeklySnapshotConfigUpdatedBy", fields: [updatedById], references: [id])

  @@index([isEnabled])
}

model WeeklySnapshot {
  id String @id @default(uuid())

  week  Int
  month Int
  year  Int

  weekStartDate DateTime
  weekEndDate   DateTime
  snapshotDate  DateTime @default(now())

  totalRisks    Int @default(0)
  openRisks     Int @default(0)
  closedRisks   Int @default(0)
  canceledRisks Int @default(0)

  redRisks    Int @default(0)
  yellowRisks Int @default(0)
  greenRisks  Int @default(0)
  orangeRisks Int @default(0)
  greyRisks   Int @default(0)
  blueRisks   Int @default(0)

  totalParts  Int @default(0)
  redParts    Int @default(0)
  yellowParts Int @default(0)
  greenParts  Int @default(0)
  orangeParts Int @default(0)
  greyParts   Int @default(0)
  blueParts   Int @default(0)

  totalActionPlans             Int @default(0)
  openActionPlans              Int @default(0)
  inProgressActionPlans        Int @default(0)
  waitingValidationActionPlans Int @default(0)
  completedActionPlans         Int @default(0)
  canceledActionPlans          Int @default(0)
  overdueActionPlans           Int @default(0)

  totalLogisticsRequests    Int @default(0)
  pendingLogisticsRequests  Int @default(0)
  inReviewLogisticsRequests Int @default(0)
  approvedLogisticsRequests Int @default(0)
  rejectedLogisticsRequests Int @default(0)
  canceledLogisticsRequests Int @default(0)

  risksCreatedThisWeek  Int @default(0)
  risksClosedThisWeek   Int @default(0)
  risksCanceledThisWeek Int @default(0)
  risksReopenedThisWeek Int @default(0)

  risksImprovedThisWeek Int @default(0)
  risksWorsenedThisWeek Int @default(0)

  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([week, year])
  @@index([month, year])
  @@index([year])
}

model WeeklyRiskAnalystSnapshot {
  id String @id @default(uuid())

  userId String

  week  Int
  month Int
  year  Int

  weekStartDate DateTime
  weekEndDate   DateTime
  snapshotDate  DateTime @default(now())

  assignedRisks Int @default(0)
  openRisks     Int @default(0)
  closedRisks   Int @default(0)
  canceledRisks Int @default(0)

  redRisks    Int @default(0)
  yellowRisks Int @default(0)
  greenRisks  Int @default(0)
  orangeRisks Int @default(0)
  greyRisks   Int @default(0)
  blueRisks   Int @default(0)

  risksCreatedThisWeek  Int @default(0)
  risksAssignedThisWeek Int @default(0)
  risksClosedThisWeek   Int @default(0)
  risksCanceledThisWeek Int @default(0)
  risksReopenedThisWeek Int @default(0)

  risksImprovedThisWeek Int @default(0)
  risksWorsenedThisWeek Int @default(0)

  actionPlansTotal             Int @default(0)
  actionPlansOpen              Int @default(0)
  actionPlansOverdue           Int @default(0)
  actionPlansWaitingValidation Int @default(0)

  oldestOpenRiskDays Int?
  avgResolutionDays  Float?

  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week, year])
  @@index([userId])
  @@index([week, year])
  @@index([month, year])
}

model WeeklyLogisticsSnapshot {
  id String @id @default(uuid())

  userId String

  week  Int
  month Int
  year  Int

  weekStartDate DateTime
  weekEndDate   DateTime
  snapshotDate  DateTime @default(now())

  assignedRequests Int @default(0)
  pendingRequests  Int @default(0)
  inReviewRequests Int @default(0)
  approvedRequests Int @default(0)
  rejectedRequests Int @default(0)
  canceledRequests Int @default(0)

  requestsReceivedThisWeek Int @default(0)
  requestsAcceptedThisWeek Int @default(0)
  requestsApprovedThisWeek Int @default(0)
  requestsRejectedThisWeek Int @default(0)
  requestsCanceledThisWeek Int @default(0)

  partsUnderLogisticsReview Int @default(0)
  partsApprovedThisWeek     Int @default(0)

  oldestPendingRequestDays Int?
  avgReviewDays            Float?

  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week, year])
  @@index([userId])
  @@index([week, year])
  @@index([month, year])
}

model WeeklySnapshotEvent {
  id String @id @default(uuid())

  week  Int
  month Int
  year  Int

  weekStartDate DateTime
  weekEndDate   DateTime

  eventType WeeklySnapshotEventType

  riskEventId        String?
  riskEventPartId    String?
  logisticsRequestId String?
  actionPlanId       String?

  userId String?

  oldValue String?
  newValue String?

  description String?

  createdAt DateTime @default(now())

  riskEvent        RiskEvent?        @relation(fields: [riskEventId], references: [id], onDelete: SetNull)
  riskEventPart    RiskEventPart?    @relation(fields: [riskEventPartId], references: [id], onDelete: SetNull)
  logisticsRequest LogisticsRequest? @relation(fields: [logisticsRequestId], references: [id], onDelete: SetNull)
  actionPlan       RiskActionPlan?   @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([week, year])
  @@index([month, year])
  @@index([eventType])
  @@index([riskEventId])
  @@index([riskEventPartId])
  @@index([logisticsRequestId])
  @@index([actionPlanId])
  @@index([userId])
}

model RiskSequence {
  key           String   @id
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
}

//////////////////////
// USERS & RBAC
//////////////////////

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  photoUrl     String?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Auditoria da ativação
  activatedAt   DateTime?
  activatedById String?

  activatedBy User?  @relation("UserActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  activatedUsers User[] @relation("UserActivatedBy")

  roles    UserRole[]
  comments Comment[]

  createdRisks  RiskEvent[] @relation("CreatedBy")
  assignedRisks RiskEvent[] @relation("AssignedTo")
  closedRisks   RiskEvent[] @relation("ClosedBy")

  riskPartsAssigned       RiskEventPart[]        @relation("RiskPartAssignedTo")
  riskPartHistory         RiskEventPartHistory[] @relation("RiskPartHistoryChangedBy")
  riskActionPlanHistories RiskActionPlanHistory[] @relation("RiskActionPlanHistoryChangedBy")

  logisticsRequested LogisticsRequest[] @relation("LogisticsRequestedBy")
  logisticsAssigned  LogisticsRequest[] @relation("LogisticsAssignedTo")
  logisticsReviewed  LogisticsRequest[] @relation("LogisticsReviewedBy")

  createdActionPlans   RiskActionPlan[] @relation("ActionPlanCreatedBy")
  assignedActionPlans  RiskActionPlan[] @relation("ActionPlanAssignedTo")
  validatedActionPlans RiskActionPlan[] @relation("ActionPlanValidatedBy")

  createdWeeklySnapshotConfigs WeeklySnapshotConfig[] @relation("WeeklySnapshotConfigCreatedBy")

  updatedWeeklySnapshotConfigs WeeklySnapshotConfig[] @relation("WeeklySnapshotConfigUpdatedBy")

  weeklyRiskAnalystSnapshots WeeklyRiskAnalystSnapshot[]
  weeklyLogisticsSnapshots   WeeklyLogisticsSnapshot[]
  weeklySnapshotEvents       WeeklySnapshotEvent[]

  buffersCreated LogisticsBuffer[] @relation("BufferCreator")

  notifications Notification[]

  auditLogs     AuditLog[]
  statusChanges RiskStatusHistory[]
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id   String @id @default(uuid())
  name String @unique

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

//////////////////////
// LOCATION
//////////////////////

model Country {
  id      String @id @default(uuid())
  name    String
  isoCode String @unique

  suppliers Supplier[]
}

//////////////////////
// SUPPLIERS
//////////////////////

model Supplier {
  id                  String         @id @default(uuid())
  name                String
  supplierCodeSap     String?        @unique
  status              SupplierStatus @default(ACTIVE)
  address             String?
  countryId           String
  riskScore           Int?
  lastRiskCalculation DateTime?
  createdAt           DateTime       @default(now())

  country    Country             @relation(fields: [countryId], references: [id])
  contacts   SupplierContact[]
  riskEvents RiskEvent[]
  riskScores SupplierRiskScore[]
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  name       String
  email      String?
  phone      String?
  position   String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

//////////////////////
// RISK CORE
//////////////////////

model RiskEvent {
  id String @id @default(uuid())

  code           String         @unique
  sequenceNumber Int            @unique
  codePrefix     RiskCodePrefix

  title       String?
  description String?

  openingReason RiskOpeningReason

  supplierId String

  commodity       String?
  functionalGroup String?

  workflowStatus RiskWorkflowStatus @default(OPEN)
  riskLevel      RiskLevel          @default(GREEN)

  createdWeek Int
  createdYear Int

  createdById  String
  assignedToId String?
  closedById   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdBy  User  @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])
  closedBy   User? @relation("ClosedBy", fields: [closedById], references: [id])

  parts                    RiskEventPart[]
  actionPlans              RiskActionPlan[]
  comments                 Comment[]
  logistics                LogisticsRequest[]
  statusHistory            RiskStatusHistory[]
  partHistory              RiskEventPartHistory[]
  actionPlanHistory        RiskActionPlanHistory[]
  weeklySnapshotEvents     WeeklySnapshotEvent[]
  weeklyRiskStateSnapshots WeeklyRiskStateSnapshot[]

  @@index([code])
  @@index([sequenceNumber])
  @@index([supplierId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([workflowStatus])
  @@index([riskLevel])
  @@index([commodity])
  @@index([functionalGroup])
  @@index([createdWeek, createdYear])
}

model RiskEventPart {
  id           String @id @default(uuid())
  riskEventId  String
  partNumberId String

  status PartRiskStatus @default(GREEN)

  logisticsStatus RiskPartLogisticsStatus @default(NOT_REQUESTED)

  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEvent  RiskEvent  @relation(fields: [riskEventId], references: [id])
  partNumber PartNumber @relation(fields: [partNumberId], references: [id])

  assignedTo User? @relation("RiskPartAssignedTo", fields: [assignedToId], references: [id])

  logisticsRequests    LogisticsRequest[]
  history              RiskEventPartHistory[]
  actionPlans          RiskActionPlan[]
  actionPlanHistory    RiskActionPlanHistory[]
  assessment           RiskPartAssessment?
  vehicleApplications  RiskEventPartApplication[]
  weeklySnapshotEvents WeeklySnapshotEvent[]

  @@unique([riskEventId, partNumberId])
  @@index([riskEventId])
  @@index([partNumberId])
  @@index([status])
  @@index([logisticsStatus])
}

model RiskPartAssessment {
  id              String @id @default(uuid())
  riskEventPartId String @unique

  isPartCanceled Boolean?
  hasDemand      Boolean?
  sourceNamed    Boolean?

  actionPlanReceived       Boolean?
  scheduleMeetsDevelopment Boolean?
  technicalCommercialOk    Boolean?
  productionRiskMitigated  Boolean?
  eopManagementOk          Boolean?

  deviationPfpFinished    Boolean?
  onlyVdaPending          Boolean?
  vdaApproved             Boolean?
  modificationImplemented Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEventPart RiskEventPart @relation(fields: [riskEventPartId], references: [id], onDelete: Cascade)

  @@index([riskEventPartId])
}

model RiskActionPlan {
  id String @id @default(uuid())

  riskEventId     String
  riskEventPartId String?

  title          String  @default("Plano de ação")
  description    String?
  requiredAction String?

  assignedToId    String?
  responsibleArea String?

  dueDate DateTime?

  priority RiskActionPlanPriority @default(MEDIUM)
  status   RiskActionPlanStatus   @default(OPEN)

  submittedAt   DateTime?
  validatedAt   DateTime?
  validatedById String?

  evidenceUrl  String?
  closingNotes String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEvent            RiskEvent               @relation(fields: [riskEventId], references: [id], onDelete: Cascade)
  riskEventPart        RiskEventPart?          @relation(fields: [riskEventPartId], references: [id], onDelete: SetNull)
  createdBy            User                    @relation("ActionPlanCreatedBy", fields: [createdById], references: [id])
  assignedTo           User?                   @relation("ActionPlanAssignedTo", fields: [assignedToId], references: [id])
  validatedBy          User?                   @relation("ActionPlanValidatedBy", fields: [validatedById], references: [id])
  weeklySnapshotEvents WeeklySnapshotEvent[]
  history              RiskActionPlanHistory[]

  @@index([riskEventId])
  @@index([riskEventPartId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([validatedById])
  @@index([dueDate])
  @@index([priority])
  @@index([status])
}

model RiskEventPartHistory {
  id String @id @default(uuid())

  riskEventPartId String?
  riskEventId     String
  partNumberId    String

  changeType RiskPartHistoryType

  oldStatus PartRiskStatus?
  newStatus PartRiskStatus?

  oldLogisticsStatus RiskPartLogisticsStatus?
  newLogisticsStatus RiskPartLogisticsStatus?

  oldAssignedToId String?
  newAssignedToId String?

  oldDescription String?
  newDescription String?

  oldVehicleProgram String?
  newVehicleProgram String?

  reason String

  changedById String
  changedAt   DateTime @default(now())

  riskEventPart RiskEventPart? @relation(fields: [riskEventPartId], references: [id], onDelete: SetNull)
  riskEvent     RiskEvent      @relation(fields: [riskEventId], references: [id])
  partNumber    PartNumber     @relation(fields: [partNumberId], references: [id])
  changedBy     User           @relation("RiskPartHistoryChangedBy", fields: [changedById], references: [id])

  @@index([riskEventPartId])
  @@index([riskEventId])
  @@index([partNumberId])
  @@index([changedById])
  @@index([changedAt])
  @@index([riskEventId, changedAt])
  @@index([partNumberId, changedAt])
}

model RiskActionPlanHistory {
  id String @id @default(uuid())

  actionPlanId String?
  riskEventId  String

  riskEventPartId String?
  partNumberId    String?

  changeType RiskActionPlanHistoryType

  oldTitle String?
  newTitle String?

  oldDescription String?
  newDescription String?

  oldRequiredAction String?
  newRequiredAction String?

  oldResponsibleArea String?
  newResponsibleArea String?

  oldDueDate DateTime?
  newDueDate DateTime?

  oldPriority RiskActionPlanPriority?
  newPriority RiskActionPlanPriority?

  oldStatus RiskActionPlanStatus?
  newStatus RiskActionPlanStatus?

  oldAssignedToId String?
  newAssignedToId String?

  oldValidatedById String?
  newValidatedById String?

  oldSubmittedAt DateTime?
  newSubmittedAt DateTime?

  oldValidatedAt DateTime?
  newValidatedAt DateTime?

  oldEvidenceUrl String?
  newEvidenceUrl String?

  oldClosingNotes String?
  newClosingNotes String?

  oldCompleted Boolean?
  newCompleted Boolean?

  reason String?

  changedById String
  changedAt   DateTime @default(now())

  actionPlan    RiskActionPlan? @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  riskEvent     RiskEvent       @relation(fields: [riskEventId], references: [id])
  riskEventPart RiskEventPart?  @relation(fields: [riskEventPartId], references: [id], onDelete: SetNull)
  partNumber    PartNumber?     @relation(fields: [partNumberId], references: [id], onDelete: SetNull)
  changedBy     User            @relation("RiskActionPlanHistoryChangedBy", fields: [changedById], references: [id])

  @@index([actionPlanId])
  @@index([riskEventId])
  @@index([riskEventPartId])
  @@index([partNumberId])
  @@index([changedById])
  @@index([changeType])
  @@index([changedAt])
}

//////////////////////
// PARTS
//////////////////////

model PartNumber {
  id             String   @id @default(uuid())
  partNumber     String   @unique
  description    String?
  vehicleProgram String?
  createdAt      DateTime @default(now())

  riskParts RiskEventPart[]
  buffers   LogisticsBuffer[]

  riskPartHistory         RiskEventPartHistory[]
  riskActionPlanHistories RiskActionPlanHistory[]

  vehicleApplications PartNumberVehicleApplication[]

  @@index([partNumber])
}

//////////////////////
// LOGISTICS
//////////////////////

model LogisticsRequest {
  id   String @id @default(uuid())
  code String @unique

  riskEventId     String
  riskEventPartId String

  type     LogisticsRequestType
  status   LogisticsRequestStatus @default(PENDING)
  priority LogisticsPriority      @default(MEDIUM)

  requestedById String
  assignedToId  String?
  reviewedById  String?

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  reviewedAt  DateTime?
  canceledAt  DateTime?

  requestNotes    String?
  responseNotes   String?
  rejectionReason String?

  requestedQuantity  Int?
  calculatedQuantity Int?

  coverageStartDate DateTime?
  coverageEndDate   DateTime?

  cutoffDate      DateTime?
  cutoffReference String?

  oldPartNumber     String?
  newPartNumber     String?
  replacementReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskEvent            RiskEvent             @relation(fields: [riskEventId], references: [id], onDelete: Cascade)
  riskEventPart        RiskEventPart         @relation(fields: [riskEventPartId], references: [id], onDelete: Cascade)
  requestedBy          User                  @relation("LogisticsRequestedBy", fields: [requestedById], references: [id])
  assignedTo           User?                 @relation("LogisticsAssignedTo", fields: [assignedToId], references: [id])
  reviewedBy           User?                 @relation("LogisticsReviewedBy", fields: [reviewedById], references: [id])
  logisticsBuffers     LogisticsBuffer[]
  weeklySnapshotEvents WeeklySnapshotEvent[]

  @@index([riskEventId])
  @@index([riskEventPartId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([reviewedById])
  @@index([requestedAt])
  @@index([reviewedAt])
}

model LogisticsBuffer {
  id                 String    @id @default(uuid())
  logisticsRequestId String
  partNumberId       String
  bufferQuantity     Int
  coverageDays       Int
  validUntil         DateTime?
  notes              String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  logisticsRequest LogisticsRequest @relation(fields: [logisticsRequestId], references: [id])
  partNumber       PartNumber       @relation(fields: [partNumberId], references: [id])

  creator User @relation("BufferCreator", fields: [createdBy], references: [id])

  @@index([logisticsRequestId])
  @@index([partNumberId])
  @@index([createdBy])
}

//////////////////////
// COMMENTS & AUDIT
//////////////////////

model Comment {
  id          String   @id @default(uuid())
  riskEventId String
  userId      String
  message     String
  createdAt   DateTime @default(now())

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([riskEventId])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  changedBy  String
  createdAt  DateTime @default(now())
  ipAddress  String?

  user User @relation(fields: [changedBy], references: [id])

  @@index([changedBy])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}

//////////////////////
// ANALYTICS
//////////////////////

model RiskSnapshot {
  id               String   @id @default(uuid())
  snapshotDate     DateTime
  weekNumber       Int
  year             Int
  totalRisks       Int
  redRisks         Int
  yellowRisks      Int
  greenRisks       Int
  totalPartNumbers Int
  createdAt        DateTime @default(now())
}

model SupplierRiskScore {
  id           String   @id @default(uuid())
  supplierId   String
  score        Int
  probability  Float
  trend        Trend
  riskLevel    String
  calculatedAt DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([calculatedAt])
}

//////////////////////
// HISTORY
//////////////////////

model RiskStatusHistory {
  id          String             @id @default(uuid())
  riskEventId String
  oldStatus   RiskWorkflowStatus
  newStatus   RiskWorkflowStatus
  changedBy   String
  reason      String?
  changedAt   DateTime           @default(now())

  riskEvent RiskEvent @relation(fields: [riskEventId], references: [id])
  user      User      @relation(fields: [changedBy], references: [id])

  @@index([riskEventId])
  @@index([changedBy])
  @@index([changedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  entity    String?
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([entity, entityId])
  @@index([createdAt])
}

model VehicleFamily {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models VehicleModel[]

  @@index([name])
  @@index([isActive])
}

model VehicleModel {
  id String @id @default(uuid())

  familyId String

  code        String
  name        String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family VehicleFamily @relation(fields: [familyId], references: [id], onDelete: Restrict)

  applications PartNumberVehicleApplication[]

  @@unique([familyId, code])
  @@index([familyId])
  @@index([code])
  @@index([isActive])
}

model PartNumberVehicleApplication {
  id String @id @default(uuid())

  partNumberId   String
  vehicleModelId String

  validFrom DateTime?
  validTo   DateTime?

  isActive Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partNumber   PartNumber   @relation(fields: [partNumberId], references: [id], onDelete: Cascade)
  vehicleModel VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)

  riskEventPartApplications RiskEventPartApplication[]

  @@unique([partNumberId, vehicleModelId, validFrom, validTo])
  @@index([partNumberId])
  @@index([vehicleModelId])
  @@index([validTo])
  @@index([isActive])
}

model RiskEventPartApplication {
  id String @id @default(uuid())

  riskEventPartId                String
  partNumberVehicleApplicationId String

  createdAt DateTime @default(now())

  riskEventPart RiskEventPart @relation(fields: [riskEventPartId], references: [id], onDelete: Cascade)

  partNumberVehicleApplication PartNumberVehicleApplication @relation(fields: [partNumberVehicleApplicationId], references: [id], onDelete: Cascade)

  @@unique([riskEventPartId, partNumberVehicleApplicationId])
  @@index([riskEventPartId])
  @@index([partNumberVehicleApplicationId])
}
